---
// The demo video with a custom player: a large play button over the poster,
// then a minimal control bar (play/pause, seekable progress, time, mute,
// fullscreen). Without JavaScript it falls back to the native controls.
//
// The video is generated by video/ (npm run video).
interface Props {
  src: string;
  poster: string;
  caption?: string;
}
const { src, poster, caption } = Astro.props;
---

<figure class="player" data-state="idle">
  <div class="frame">
    <video src={src} poster={poster} preload="metadata" playsinline controls width="1920" height="1080"></video>

    <button class="big-play" type="button" aria-label="Play the demo">
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
    </button>

    <div class="bar">
      <button class="ctl toggle" type="button" aria-label="Play">
        <svg class="i-play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
        <svg class="i-pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"></path></svg>
      </button>
      <span class="time"><span class="cur">0:00</span> / <span class="dur">0:00</span></span>
      <div class="track" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="buffered"></div>
        <div class="progress"></div>
      </div>
      <button class="ctl mute" type="button" aria-label="Mute">
        <svg class="i-sound" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <svg class="i-muted" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4zM17 9.5l5 5M22 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button class="ctl fs" type="button" aria-label="Fullscreen">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const fmt = (s: number) => {
    if (!Number.isFinite(s)) return '0:00';
    const m = Math.floor(s / 60);
    return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('.player').forEach((root) => {
    const video = root.querySelector('video')!;
    const frame = root.querySelector<HTMLElement>('.frame')!;
    const big = root.querySelector<HTMLButtonElement>('.big-play')!;
    const toggle = root.querySelector<HTMLButtonElement>('.toggle')!;
    const mute = root.querySelector<HTMLButtonElement>('.mute')!;
    const fs = root.querySelector<HTMLButtonElement>('.fs')!;
    const track = root.querySelector<HTMLElement>('.track')!;
    const progress = root.querySelector<HTMLElement>('.progress')!;
    const buffered = root.querySelector<HTMLElement>('.buffered')!;
    const cur = root.querySelector<HTMLElement>('.cur')!;
    const dur = root.querySelector<HTMLElement>('.dur')!;

    // JS is running: swap the native controls for ours.
    video.controls = false;
    root.classList.add('custom');

    const setState = () => {
      root.dataset.state = video.ended ? 'ended' : video.paused ? (video.currentTime > 0 ? 'paused' : 'idle') : 'playing';
      toggle.setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
    };
    const play = () => {
      if (video.ended) video.currentTime = 0;
      video.play().catch(() => {});
    };
    const playPause = () => (video.paused ? play() : video.pause());

    big.addEventListener('click', play);
    toggle.addEventListener('click', playPause);
    video.addEventListener('click', playPause);
    for (const e of ['play', 'pause', 'ended', 'loadedmetadata']) video.addEventListener(e, setState);

    video.addEventListener('loadedmetadata', () => (dur.textContent = fmt(video.duration)));
    video.addEventListener('timeupdate', () => {
      const p = video.duration ? video.currentTime / video.duration : 0;
      progress.style.transform = `scaleX(${p})`;
      track.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      cur.textContent = fmt(video.currentTime);
    });
    video.addEventListener('progress', () => {
      if (video.buffered.length && video.duration) {
        buffered.style.transform = `scaleX(${video.buffered.end(video.buffered.length - 1) / video.duration})`;
      }
    });

    // Seek by click or drag.
    const seekTo = (clientX: number) => {
      const r = track.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
      if (video.duration) video.currentTime = p * video.duration;
    };
    track.addEventListener('pointerdown', (e) => {
      track.setPointerCapture(e.pointerId);
      seekTo(e.clientX);
      const move = (ev: PointerEvent) => seekTo(ev.clientX);
      track.addEventListener('pointermove', move);
      track.addEventListener('pointerup', () => track.removeEventListener('pointermove', move), { once: true });
    });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') video.currentTime = Math.min(video.duration, video.currentTime + 5);
      else if (e.key === 'ArrowLeft') video.currentTime = Math.max(0, video.currentTime - 5);
      else return;
      e.preventDefault();
    });

    mute.addEventListener('click', () => {
      video.muted = !video.muted;
      root.classList.toggle('muted', video.muted);
      mute.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
    });

    fs.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (frame.requestFullscreen) frame.requestFullscreen();
      else (video as any).webkitEnterFullscreen?.(); // iOS Safari
    });

    // Keyboard: space / k toggles when the player has focus.
    root.addEventListener('keydown', (e) => {
      if ((e.key === ' ' || e.key === 'k') && e.target !== track && !(e.target instanceof HTMLButtonElement)) {
        e.preventDefault();
        playPause();
      }
    });

    // Pause when scrolled out of view.
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting && !video.paused) video.pause();
    }, { threshold: 0.2 }).observe(root);

    setState();
  });
</script>

<style>
  .player {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow:
      0 0 0 1px rgb(99 102 241 / 0.12),
      0 30px 90px -50px rgb(99 102 241 / 0.5);
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }
  /* Dim the poster until the video starts, so the play button reads. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgb(11 13 22 / 0.35), rgb(11 13 22 / 0.65));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .custom[data-state='idle'] .frame::after,
  .custom[data-state='ended'] .frame::after {
    opacity: 1;
  }
  .big-play {
    z-index: 1;
  }
  .frame:fullscreen {
    border-radius: 0;
    border: 0;
  }
  .frame:fullscreen video {
    object-fit: contain;
  }

  /* Hidden until JS takes over from the native controls. */
  .big-play,
  .bar {
    display: none;
  }
  .custom .big-play {
    display: grid;
  }
  .custom .bar {
    display: flex;
  }

  .big-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 84px;
    height: 84px;
    place-items: center;
    padding: 0 0 0 4px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    color: #fff;
    background: rgb(11 13 22 / 0.45);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: transform 0.2s, opacity 0.25s, background 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 0 0 rgb(99 102 241 / 0.5);
  }
  .big-play:hover {
    transform: scale(1.06);
    background: rgb(99 102 241 / 0.55);
    box-shadow: 0 0 0 10px rgb(99 102 241 / 0.12);
  }
  .player:not([data-state='idle']):not([data-state='ended']) .big-play {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9);
  }

  .bar {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border-radius: 12px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(11 13 22 / 0.6);
    backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    transition: opacity 0.25s, transform 0.25s;
  }
  /* The bar shows on hover, on focus, and whenever the video is not playing. */
  .player[data-state='playing'] .bar {
    opacity: 0;
    transform: translateY(6px);
  }
  .player[data-state='playing'] .frame:hover .bar,
  .player[data-state='playing'] .bar:focus-within {
    opacity: 1;
    transform: none;
  }
  .player[data-state='idle'] .bar {
    opacity: 0;
    pointer-events: none;
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .ctl:hover {
    background: rgb(255 255 255 / 0.08);
  }
  .i-pause,
  .i-muted {
    display: none;
  }
  .player[data-state='playing'] .i-play {
    display: none;
  }
  .player[data-state='playing'] .i-pause {
    display: block;
  }
  .muted .i-sound {
    display: none;
  }
  .muted .i-muted {
    display: block;
  }
  .time {
    color: var(--muted);
    white-space: nowrap;
  }
  .time .cur {
    color: var(--text);
  }

  .track {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    cursor: pointer;
    touch-action: none;
  }
  .track::before {
    /* a taller hit area */
    content: '';
    position: absolute;
    inset: -10px 0;
  }
  .buffered,
  .progress {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0);
  }
  .buffered {
    background: rgb(255 255 255 / 0.12);
  }
  .progress {
    background: var(--grad);
  }
  .track:focus-visible,
  .ctl:focus-visible,
  .big-play:focus-visible {
    outline: 2px solid var(--c2);
    outline-offset: 2px;
  }

  figcaption {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (max-width: 560px) {
    .time {
      display: none;
    }
    .big-play {
      width: 64px;
      height: 64px;
    }
  }
</style>
