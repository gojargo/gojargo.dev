---
// GitHub icon + star count, opening the repository in a new tab. Used in the
// site nav and, through the SocialIcons override, in the docs header.
import { formatCount, githubStars, githubUrl } from '../lib/github';

const stars = await githubStars();
const label = stars == null ? 'jargo on GitHub' : `jargo on GitHub, ${stars} stars`;
---

<a class="gh-link" href={githubUrl} target="_blank" rel="noopener" aria-label={label} title={label}>
  <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
  {
    stars != null && (
      <span class="stars">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"></path></svg>
        {formatCount(stars)}
      </span>
    )
  }
</a>

<style>
  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line, var(--sl-color-hairline, rgb(127 127 127 / 0.3)));
    color: inherit;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: border-color 0.15s, background 0.15s;
  }
  .gh-link:hover {
    border-color: rgb(99 102 241 / 0.6);
    background: rgb(99 102 241 / 0.08);
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .stars svg {
    color: #fbbf24;
  }
</style>
