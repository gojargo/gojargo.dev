---
import '@fontsource-variable/inter';
import '../styles/site.css';
import GitHubLink from '../components/GitHubLink.astro';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD objects for this page (schema.org). */
  structuredData?: object[];
}
const {
  title,
  description = 'Real-time voice agents in Go, for the browser, phone, LiveKit and WhatsApp.',
  structuredData = [],
} = Astro.props;
const image = new URL('/og.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#0b0d16" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="jargo" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="jargo: voice agents in Go" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <img src="/favicon.png" alt="" width="26" height="26" />
        <span>jargo</span>
      </a>
      <nav>
        <a href="/docs/" aria-current={path.startsWith('/docs') ? 'page' : undefined}>Docs</a>
        <a href="/#demo">Demo</a>
        <a href="https://pkg.go.dev/github.com/gojargo/jargo" class="hide-sm" target="_blank" rel="noopener">Reference</a>
        <GitHubLink />
      </nav>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>jargo · BSD-2-Clause</span>
        <span class="footer-links">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/gojargo/jargo" target="_blank" rel="noopener">GitHub</a>
          <a href="https://github.com/gojargo/jargo/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a>
        </span>
      </div>
    </footer>
  </body>
</html>
